server {
    listen 80;
    server_name _;
    server_tokens off;

    # Docker's embedded DNS, re-resolved per request (valid=10s). Without
    # this, proxy_pass hostnames resolve ONCE at startup and nginx dials a
    # dead container IP forever after any recreate — the classic mystery 502.
    # Every proxy_pass below therefore goes through a variable (which forces
    # runtime resolution) instead of a static hostname.
    resolver 127.0.0.11 valid=10s ipv6=off;

    root /usr/share/nginx/html;
    index index.html;

    # Baseline hardening headers. No inline scripts, plugins, or third-party
    # resources exist in the bundle, and all API traffic is same-origin, so
    # this policy does not change application behavior.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    # HSTS is opt-in: it only has an effect once a valid certificate is served
    # in front of this block (browsers ignore HSTS received over plain HTTP,
    # so leaving it "off" is safe for LAN/HTTP-only installs). Set
    # PROXVM_HSTS_HEADER below to enable it, e.g.
    #   PROXVM_HSTS_HEADER=add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    # The nginx entrypoint substitutes this variable at container start.
    ${PROXVM_HSTS_HEADER}
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'" always;

    # Upstream error responses pass through untouched: the API already
    # answers every failure with safe, user-actionable JSON (auth, validation,
    # Proxmox/Gotify upstream errors), and the UI renders server messages
    # verbatim. Do NOT add proxy_intercept_errors / error_page here — an
    # earlier revision converted every 502 into a generic "briefly
    # unavailable", which masked real errors (e.g. a down Gotify server
    # reported as a ProxVM outage). A truly dead backend still yields
    # nginx's HTML 502, which the UI's friendlyHttpMessage() already
    # translates to the same "briefly unavailable" wording.
    location /api/ {
        set $upstream_api http://api:4000;
        proxy_pass $upstream_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    location / {
        try_files $uri /index.html;
    }
}
