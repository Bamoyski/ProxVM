# ProxVM environment configuration (example values — replace everything before use).
#
# Most runtime configuration lives in .proxvm/config.json and is created by the
# setup wizard on first start. The variables below are the only ones read from
# the environment.

# Directory holding config.json (contains the AES-256-GCM master key and the
# session signing key — never commit the real directory).
PROXVM_CONFIG_DIR=./.proxvm

# API listen address/port. Bind 127.0.0.1 if a reverse proxy on this host is
# the only thing that should reach the API directly.
PROXVM_HOST=0.0.0.0
PROXVM_PORT=4000

# Public origin of the web UI, used for CORS and secure-cookie decisions.
# Optional when a canonical domain is set (Settings → Domains): the API then
# accepts the canonical https origin plus every redirect alias automatically.
# Keep this set for LAN/IP access or dev origins (e.g. http://localhost:5173).
# Example: PROXVM_WEB_ORIGIN=https://proxvm.example.com
PROXVM_WEB_ORIGIN=

# Trust X-Forwarded-For for client IPs (rate limits, audit IPs). Default is
# UNSET (never trust: IPs come from the socket and cannot be spoofed).
# Use a comma-separated CIDR list to trust only hops you control (your
# reverse proxy / docker network, which appends the real client IP last),
# e.g. PROXVM_TRUST_PROXY=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16.
# Behind Cloudflare Tunnel, ALSO append the tunnel egress IP (the box
# running cloudflared): the edge appends the true visitor IP just inside
# it, so trusting the egress resolves tunneled logins to real clients.
# That egress IP needs a DHCP reservation or the attribution silently
# regresses when it drifts.
# Trusted hops also count as "shared egress" for threat detection: a row
# whose IP is on this list identifies the hop, never the client (every
# tunneled user shows the same address), so per-IP findings — spray,
# compromised login, first login from a new IP, recon scans — skip it,
# while per-account rules still see every event.
# PROXVM_TRUST_PROXY=1 trusts every hop — only behind a proxy you fully
# control. Direct connections from untrusted addresses always fall back to
# the socket IP either way.
# PROXVM_TRUST_PROXY=

# Cloudflare domain automation (all optional). When set, these win over the
# Domains-page settings, so the connection box never needs filling in.
# The API token needs Zone:Read + DNS:Edit and Account Tunnel:Read/Edit.
# This file is only an example — put real values in a local .env, which is
# gitignored and never mirrored anywhere.
# PROXVM_CLOUDFLARE_API_TOKEN=
# PROXVM_CLOUDFLARE_ZONE_ID=
# PROXVM_CLOUDFLARE_ACCOUNT_ID=
# PROXVM_CLOUDFLARE_TUNNEL_ID=

# Node environment: development | production
NODE_ENV=development

# Refuse to start unless session cookies are Secure-flagged (config
# app.cookieSecure = true). Recommended for any internet-exposed deployment
# that terminates TLS in front of ProxVM. Leave unset for plain-HTTP homelab
# setups, which would otherwise fail to boot.
# PROXVM_ENFORCE_SECURE_COOKIES=1

# API log level: debug | info | warn | error
PROXVM_LOG_LEVEL=info

# ---- Docker Compose (docker-compose.yml) ----
POSTGRES_DB=proxvm
POSTGRES_USER=proxvm
POSTGRES_PASSWORD=change-me-to-a-strong-password

# HSTS for the bundled nginx (web service). Off unless set. Enable only once a
# valid certificate is served in front of the web service; browsers ignore
# HSTS over plain HTTP, so leaving it empty is safe for HTTP-only installs.
# PROXVM_HSTS_HEADER=add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

# ---- Integration tests only (never needed for normal use) ----
# Set PROXVM_INTEGRATION=1 plus the variables below to run the test suite
# against real Proxmox infrastructure (see README "Testing").
# PROXVM_INTEGRATION=
# PROXMOX_URL=https://proxmox.example.com:8006
# PROXMOX_TOKEN_ID=root@pam!example-token-name
# PROXMOX_TOKEN_SECRET=replace-me
# PROXMOX_VERIFY_SSL=true
